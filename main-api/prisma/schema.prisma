generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MASTER_ADMIN

  @@map("user_role")
}

enum SensitiveDocumentType {
  CPF
  CNPJ

  @@map("sensitive_document_type")
}

enum CommercialEntityType {
  INDIVIDUAL
  LEGAL_ENTITY

  @@map("commercial_entity_type")
}

enum EmploymentState {
  ACTIVE
  TERMINATED

  @@map("employment_state")
}

enum MachineType {
  YELLOW_LINE
  WHITE_LINE

  @@map("machine_type")
}

enum MachineIdentifierKind {
  PLATE
  COMPANY_TAG

  @@map("machine_identifier_kind")
}

enum MachineMeterType {
  HOUR_METER
  ODOMETER

  @@map("machine_meter_type")
}

enum MachineMeterReadingPurpose {
  INITIAL
  OWNERSHIP_TRANSFER
  ORDINARY

  @@map("machine_meter_reading_purpose")
}

enum MachineMeterReadingStatus {
  CONFIRMED

  @@map("machine_meter_reading_status")
}

enum ProjectLifecycleStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@map("project_lifecycle_status")
}

enum ProjectWorkFrontStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED

  @@map("project_work_front_status")
}

enum ProjectWorkFrontEmployeeAssignmentSource {
  DIRECT
  MACHINE_OPERATOR
  BOTH

  @@map("project_work_front_employee_assignment_source")
}

enum ProjectDailyReportShift {
  DAY
  NIGHT

  @@map("project_daily_report_shift")
}

enum ProjectDailyReportStatus {
  DRAFT
  FINALIZED

  @@map("project_daily_report_status")
}

enum ProjectDailyReportActivityType {
  EARTHWORKS
  DRAINAGE
  PAVING

  @@map("project_daily_report_activity_type")
}

enum ProjectDailyReportClimateCondition {
  RAIN
  DRY
  WATERLOGGED_SOIL

  @@map("project_daily_report_climate_condition")
}

enum ProjectProductionStatus {
  DRAFT
  SUBMITTED
  FIELD_CHECKED
  AWAITING_TECHNICAL
  APPROVED
  REJECTED
  RELEASED
  MEASURED

  @@map("project_production_status")
}

enum ProjectProductionEntryMode {
  DIRECT_TOTAL
  TRUCK_SUMMARY
  TRIPS

  @@map("project_production_entry_mode")
}

enum ProjectProductionVolumeCondition {
  CUT
  BANK
  LOOSE
  COMPACTED
  PLACED

  @@map("project_production_volume_condition")
}

enum ProjectProductionProfile {
  GENERIC
  EXCAVATION
  LOADING
  TRANSPORT
  SPREADING
  GRADING
  COMPACTION

  @@map("project_production_profile")
}

enum ProjectProductionDmtPolicy {
  NOT_APPLICABLE
  OPTIONAL
  REQUIRED

  @@map("project_production_dmt_policy")
}

enum ProjectProductionEquipmentRole {
  EXCAVATION
  LOADING
  TRANSPORT
  SPREADING
  GRADING
  COMPACTION
  WATERING
  SUPPORT

  @@map("project_production_equipment_role")
}

enum ProjectProductionRevisionEvent {
  CREATED
  UPDATED
  SUBMITTED
  FIELD_CHECKED
  AWAITING_TECHNICAL
  APPROVED
  DIRECT_APPROVED
  REJECTED
  RELEASED
  QUALITY_RECORDED
  REOPENED
  TRIP_ADDED
  TRIP_REMOVED
  RDO_CONFIRMED

  @@map("project_production_revision_event")
}

enum ProjectProductionKind {
  INDIVIDUAL_ACTIVITY
  MATERIAL_MOVEMENT

  @@map("project_production_kind")
}

enum ProjectProductionComponentType {
  INDIVIDUAL
  CUT
  LOADING
  TRANSPORT
  UNLOADING
  SPREADING
  COMPACTION
  FILL
  FINISHING

  @@map("project_production_component_type")
}

enum ProjectProductionQuantityKind {
  OPERATIONAL
  ESTIMATED
  TECHNICALLY_ACCEPTED
  CONTRACT_MEASURED

  @@map("project_production_quantity_kind")
}

enum ProjectProductionQuantityMethod {
  MANUAL
  TRUCK_SUMMARY
  TRIP_EVENTS
  WEIGHBRIDGE
  CONVERTED
  TOPOGRAPHY
  LABORATORY
  CONTRACT_MEASUREMENT

  @@map("project_production_quantity_method")
}

enum ProjectProductionQualityType {
  FIELD_INSPECTION
  TOPOGRAPHY
  DENSITY
  PROCTOR
  COMPACTION
  MOISTURE
  FINISHING

  @@map("project_production_quality_type")
}

enum ProjectProductionQualityStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("project_production_quality_status")
}

enum ProjectProductionApprovalPhase {
  SUBMISSION
  FIELD_CHECK
  TECHNICAL_CHECK
  RELEASE
  REOPEN
  MEASUREMENT

  @@map("project_production_approval_phase")
}

enum ProjectProductionApprovalDecision {
  SUBMITTED
  ACCEPTED
  REJECTED
  RELEASED
  REOPENED
  MEASURED

  @@map("project_production_approval_decision")
}

enum MachineOwnershipKind {
  OWNED
  RENTED
  THIRD_PARTY

  @@map("machine_ownership_kind")
}

model Corporation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains                        Domain[]
  companies                      Company[]
  users                          User[]
  sessions                       Session[]
  sensitiveDocumentHarnessRows   SensitiveDocumentProtectionHarness[]
  clients                        Client[]
  fuelSuppliers                  FuelSupplier[]
  persons                        Person[]
  employments                    Employment[]
  jobRoles                       JobRole[]
  machines                       Machine[]
  machineOwnershipPeriods        MachineOwnershipPeriod[]
  machineIdentifiers             MachineIdentifier[]
  machineMeterReadings           MachineMeterReading[]
  machineMeterReadingCorrections MachineMeterReadingCorrection[]
  machineMeterReadingReferences  MachineMeterReadingReference[]

  @@map("corporations")
}

model Domain {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String      @map("corporation_id") @db.Uuid
  host          String      @unique @db.VarChar(253)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation   Corporation @relation(fields: [corporationId], references: [id], onDelete: Restrict)

  @@index([corporationId])
  @@map("domains")
}

model Company {
  id                             String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId                  String                               @map("corporation_id") @db.Uuid
  name                           String                               @db.VarChar(160)
  isActive                       Boolean                              @default(true) @map("is_active")
  createdAt                      DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation                    Corporation                          @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  sessions                       Session[]
  sensitiveDocumentHarnessRows   SensitiveDocumentProtectionHarness[]
  clients                        Client[]
  fuelSuppliers                  FuelSupplier[]
  employments                    Employment[]
  jobRoles                       JobRole[]
  machineOwnershipPeriods        MachineOwnershipPeriod[]
  machineIdentifiers             MachineIdentifier[]
  machineMeterReadings           MachineMeterReading[]
  machineMeterReadingCorrections MachineMeterReadingCorrection[]
  machineMeterReadingReferences  MachineMeterReadingReference[]

  @@unique([corporationId, id])
  @@unique([corporationId, name])
  @@map("companies")
}

model User {
  id                                    String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId                         String                               @map("corporation_id") @db.Uuid
  email                                 String                               @db.VarChar(254)
  passwordHash                          String                               @map("password_hash")
  role                                  UserRole                             @default(MASTER_ADMIN)
  isActive                              Boolean                              @default(true) @map("is_active")
  createdAt                             DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                             DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation                           Corporation                          @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  sessions                              Session[]
  removedClients                        Client[]                             @relation("ClientRemovedBy")
  removedFuelSuppliers                  FuelSupplier[]                       @relation("FuelSupplierRemovedBy")
  machineMeterReadings                  MachineMeterReading[]                @relation("MachineMeterReadingActor")
  machineMeterReadingCorrections        MachineMeterReadingCorrection[]      @relation("MachineMeterReadingCorrectionActor")
  createdProjectDailyReports            ProjectDailyReport[]                 @relation("ProjectDailyReportCreatedBy")
  finalizedProjectDailyReports          ProjectDailyReport[]                 @relation("ProjectDailyReportFinalizedBy")
  createdProjectEmployeeAllocations     ProjectEmployeeAllocation[]          @relation("ProjectEmployeeAllocationCreatedBy")
  endedProjectEmployeeAllocations       ProjectEmployeeAllocation[]          @relation("ProjectEmployeeAllocationEndedBy")
  createdProjectMachineAllocations      ProjectMachineAllocation[]           @relation("ProjectMachineAllocationCreatedBy")
  endedProjectMachineAllocations        ProjectMachineAllocation[]           @relation("ProjectMachineAllocationEndedBy")
  createdProjectMachineShiftAssignments ProjectMachineShiftAssignment[]      @relation("ProjectMachineShiftAssignmentCreatedBy")
  endedProjectMachineShiftAssignments   ProjectMachineShiftAssignment[]      @relation("ProjectMachineShiftAssignmentEndedBy")
  createdWorkFrontEmployeeAssignments   ProjectWorkFrontEmployeeAssignment[] @relation("WorkFrontEmployeeAssignmentCreatedBy")
  endedWorkFrontEmployeeAssignments     ProjectWorkFrontEmployeeAssignment[] @relation("WorkFrontEmployeeAssignmentEndedBy")
  createdWorkFrontMachineAssignments    ProjectWorkFrontMachineAssignment[]  @relation("WorkFrontMachineAssignmentCreatedBy")
  endedWorkFrontMachineAssignments      ProjectWorkFrontMachineAssignment[]  @relation("WorkFrontMachineAssignmentEndedBy")
  endedEmploymentPeriods                EmploymentPeriod[]                   @relation("EmploymentPeriodEndedBy")
  endedEmploymentJobRolePeriods         EmploymentJobRolePeriod[]            @relation("EmploymentJobRolePeriodEndedBy")
  endedProjectTechnicalResponsibilities ProjectTechnicalResponsibility[]     @relation("ProjectTechnicalResponsibilityEndedBy")

  @@unique([corporationId, id])
  @@unique([corporationId, email])
  @@map("users")
}

model Session {
  id                         String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId              String                             @map("corporation_id") @db.Uuid
  userId                     String                             @map("user_id") @db.Uuid
  companyId                  String?                            @map("company_id") @db.Uuid
  refreshTokenHash           String?                            @map("refresh_token_hash")
  refreshVersion             Int                                @default(0) @map("refresh_version")
  createdAt                  DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt                 DateTime                           @default(now()) @map("last_used_at") @db.Timestamptz(3)
  idleExpiresAt              DateTime                           @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt          DateTime                           @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt                  DateTime?                          @map("revoked_at") @db.Timestamptz(3)
  revocationReason           String?                            @map("revocation_reason") @db.VarChar(120)
  corporation                Corporation                        @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  user                       User                               @relation(fields: [corporationId, userId], references: [corporationId, id], onDelete: Restrict)
  company                    Company?                           @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  consumedRefreshCredentials SessionConsumedRefreshCredential[]

  @@index([corporationId, userId])
  @@index([corporationId, companyId])
  @@map("sessions")
}

model SessionConsumedRefreshCredential {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  credentialHash String   @unique @map("credential_hash")
  consumedAt     DateTime @map("consumed_at") @db.Timestamptz(3)
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, consumedAt])
  @@map("session_consumed_refresh_credentials")
}

model SensitiveDocumentProtectionHarness {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                @map("corporation_id") @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  registryType         String                @map("registry_type") @db.VarChar(64)
  documentType         SensitiveDocumentType @map("document_type")
  ciphertext           String                @db.Text
  iv                   String                @db.VarChar(64)
  authTag              String                @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                @map("document_digest") @db.VarChar(96)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)

  @@index([corporationId, companyId, registryType])
  @@index([documentDigest])
  @@map("sensitive_document_protection_harness")
}

model Client {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                @map("corporation_id") @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  entityType           CommercialEntityType  @map("entity_type")
  documentType         SensitiveDocumentType @map("document_type")
  ciphertext           String                @db.Text
  iv                   String                @db.VarChar(64)
  authTag              String                @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                @map("document_digest") @db.VarChar(96)
  displayName          String                @map("display_name") @db.VarChar(180)
  fullName             String?               @map("full_name") @db.VarChar(180)
  legalName            String?               @map("legal_name") @db.VarChar(180)
  tradeName            String?               @map("trade_name") @db.VarChar(180)
  phone                String?               @db.VarChar(32)
  email                String?               @db.VarChar(254)
  addressLine          String?               @map("address_line") @db.VarChar(220)
  city                 String?               @db.VarChar(120)
  state                String?               @db.VarChar(80)
  postalCode           String?               @map("postal_code") @db.VarChar(24)
  isActive             Boolean               @default(true) @map("is_active")
  inactivatedAt        DateTime?             @map("inactivated_at") @db.Timestamptz(3)
  removedAt            DateTime?             @map("removed_at") @db.Timestamptz(3)
  removedByUserId      String?               @map("removed_by_user_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  removedBy            User?                 @relation("ClientRemovedBy", fields: [corporationId, removedByUserId], references: [corporationId, id], onDelete: Restrict)

  @@unique([corporationId, companyId, id])
  @@index([corporationId, companyId, isActive])
  @@index([corporationId, companyId, createdAt, id])
  @@index([corporationId, companyId, displayName, id])
  @@index([documentDigest])
  @@index([removedAt], map: "clients_removed_at_idx")
  @@map("clients")
}

model FuelSupplier {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                @map("corporation_id") @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  entityType           CommercialEntityType  @map("entity_type")
  documentType         SensitiveDocumentType @map("document_type")
  ciphertext           String                @db.Text
  iv                   String                @db.VarChar(64)
  authTag              String                @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                @map("document_digest") @db.VarChar(96)
  displayName          String                @map("display_name") @db.VarChar(180)
  fullName             String?               @map("full_name") @db.VarChar(180)
  legalName            String?               @map("legal_name") @db.VarChar(180)
  tradeName            String?               @map("trade_name") @db.VarChar(180)
  phone                String?               @db.VarChar(32)
  email                String?               @db.VarChar(254)
  addressLine          String?               @map("address_line") @db.VarChar(220)
  addressStreet        String?               @map("address_street") @db.VarChar(160)
  addressNumber        String?               @map("address_number") @db.VarChar(30)
  addressComplement    String?               @map("address_complement") @db.VarChar(100)
  addressNeighborhood  String?               @map("address_neighborhood") @db.VarChar(100)
  city                 String?               @db.VarChar(120)
  state                String?               @db.VarChar(80)
  postalCode           String?               @map("postal_code") @db.VarChar(24)
  isGlobal             Boolean               @default(true) @map("is_global")
  projectId            String?               @map("project_id") @db.Uuid
  isActive             Boolean               @default(true) @map("is_active")
  inactivatedAt        DateTime?             @map("inactivated_at") @db.Timestamptz(3)
  removedAt            DateTime?             @map("removed_at") @db.Timestamptz(3)
  removedByUserId      String?               @map("removed_by_user_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  removedBy            User?                 @relation("FuelSupplierRemovedBy", fields: [corporationId, removedByUserId], references: [corporationId, id], onDelete: Restrict)

  @@unique([corporationId, companyId, id])
  @@index([corporationId, companyId, isActive])
  @@index([corporationId, companyId, createdAt, id])
  @@index([corporationId, companyId, displayName, id])
  @@index([documentDigest])
  @@index([removedAt], map: "fuel_suppliers_removed_at_idx")
  @@map("fuel_suppliers")
}

model FuelType {
  id        String   @id @db.VarChar(32)
  name      String   @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("fuel_types")
}

model MeasurementUnit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String?  @map("corporation_id") @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  code          String   @db.VarChar(24)
  name          String   @db.VarChar(80)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([corporationId, companyId, code])
  @@index([corporationId, companyId, isActive])
  @@map("measurement_units")
}

model SuppliedItem {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId     String   @map("corporation_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  projectId         String?  @map("project_id") @db.Uuid
  categoryId        String?  @map("category_id") @db.Uuid
  name              String   @db.VarChar(160)
  baseUnitId        String   @map("base_unit_id") @db.Uuid
  valueUnitQuantity Decimal  @default(1.000000) @map("value_unit_quantity") @db.Decimal(18, 6)
  basePrice         Decimal  @default(0.0000) @map("base_price") @db.Decimal(18, 4)
  isGlobal          Boolean  @default(true) @map("is_global")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([corporationId, companyId, isGlobal, isActive])
  @@index([corporationId, companyId, projectId])
  @@index([corporationId, companyId, categoryId])
  @@map("supplied_items")
}

model SuppliedItemCategory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String   @map("corporation_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  systemKey     String?  @map("system_key") @db.VarChar(32)
  name          String   @db.VarChar(120)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([corporationId, companyId, parentId])
  @@index([corporationId, companyId, isActive])
  @@map("supplied_item_categories")
}

model SupplierOffer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId    String   @map("corporation_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  purchaseUnitId   String   @map("purchase_unit_id") @db.Uuid
  conversionToBase Decimal  @map("conversion_to_base") @db.Decimal(18, 6)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([corporationId, companyId, supplierId])
  @@index([corporationId, companyId, itemId])
  @@map("supplier_offers")
}

model SupplierOfferPrice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String    @map("corporation_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  offerId       String    @map("offer_id") @db.Uuid
  price         Decimal   @db.Decimal(18, 4)
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(3)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([corporationId, companyId, offerId])
  @@map("supplier_offer_prices")
}

model Person {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId        String                @map("corporation_id") @db.Uuid
  documentType         SensitiveDocumentType @map("document_type")
  ciphertext           String                @db.Text
  iv                   String                @db.VarChar(64)
  authTag              String                @map("auth_tag") @db.VarChar(64)
  encryptionKeyVersion String                @map("encryption_key_version") @db.VarChar(64)
  documentDigest       String                @map("document_digest") @db.VarChar(96)
  displayName          String                @map("display_name") @db.VarChar(180)
  fullName             String                @map("full_name") @db.VarChar(180)
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation          Corporation           @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  employments          Employment[]

  @@unique([corporationId, id])
  @@unique([corporationId, documentDigest])
  @@index([corporationId, displayName, id])
  @@index([documentDigest])
  @@map("persons")
}

model Employment {
  id                           String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId                String                                      @map("corporation_id") @db.Uuid
  companyId                    String                                      @map("company_id") @db.Uuid
  personId                     String                                      @map("person_id") @db.Uuid
  companyRegistrationNumber    String                                      @map("company_registration_number") @db.VarChar(80)
  state                        EmploymentState                             @default(ACTIVE)
  isActive                     Boolean                                     @default(true) @map("is_active")
  terminatedAt                 DateTime?                                   @map("terminated_at") @db.Timestamptz(3)
  createdAt                    DateTime                                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation                  Corporation                                 @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company                      Company                                     @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  person                       Person                                      @relation(fields: [corporationId, personId], references: [corporationId, id], onDelete: Restrict)
  periods                      EmploymentPeriod[]
  jobRolePeriods               EmploymentJobRolePeriod[]
  directWorkFrontAssignments   ProjectWorkFrontEmployeeAssignment[]        @relation("WorkFrontEmployeeAssignmentEmployment")
  operatedWorkFrontAssignments ProjectWorkFrontMachineAssignment[]         @relation("WorkFrontMachineAssignmentOperator")
  supervisedDailyReports       ProjectDailyReport[]                        @relation("ProjectDailyReportSupervisor")
  dailyReportResponsibilities  ProjectDailyReportTechnicalResponsibility[] @relation("ProjectDailyReportTechnicalResponsibilityEmployment")
  dailyReportEntries           ProjectDailyReportEmployee[]                @relation("ProjectDailyReportEmployeeEmployment")
  projectMachineAllocations    ProjectMachineAllocation[]

  @@unique([corporationId, companyId, id])
  @@index([corporationId, companyId, isActive])
  @@index([corporationId, companyId, createdAt, id])
  @@index([corporationId, companyId, companyRegistrationNumber], map: "employments_corporation_id_company_id_company_registration_numb")
  @@index([corporationId, personId])
  @@map("employments")
}

model JobRole {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId     String                    @map("corporation_id") @db.Uuid
  companyId         String                    @map("company_id") @db.Uuid
  name              String                    @db.VarChar(120)
  normalizedName    String                    @map("normalized_name") @db.VarChar(120)
  isActive          Boolean                   @default(true) @map("is_active")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  corporation       Corporation               @relation(fields: [corporationId], references: [id], onDelete: Restrict)
  company           Company                   @relation(fields: [corporationId, companyId], references: [corporationId, id], onDelete: Restrict)
  employmentPeriods EmploymentJobRolePeriod[]

  @@unique([corporationId, companyId, normalizedName])
  @@index([corporationId, companyId, isActive, name, id])
  @@map("job_roles")
}

model EmploymentJobRolePeriod {
  id            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  corporationId String                      @map("corporation_id") @db.Uuid
  companyId     String                      @map("company_id") @db.Uuid
  employmentId  String                      @map("employment_id") @db.Uuid
  jobRoleId     String                      @map("job_role_id") @db.Uuid
  reason        String?                     @db.VarChar(240)
  endedByUserId String?                     @map("ended_by_user_id") @db.Uuid
  endedReason   String?                     @map("ended_reason") @db.VarChar(240)
  effectiveFrom DateTime                    @map("effective_from") @db.Date
  effectiveTo   DateTime?                   @map("effective_to") @db.Date
  createdAt     DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  employment    Employment                  @relation(fields: [corporationId, companyId, employmentId], references: [corporationId, companyId, id], onDelete: Restrict)
  jobRole       JobRole                     @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)
  endedBy       User?                       @relation("EmploymentJobRolePeriodEndedBy", fields: [corporationId, endedByUserId], references: [corporationId, id], onDelete: Restrict)
